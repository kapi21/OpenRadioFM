<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="@dimen/dp_h2" android:bottom="@dimen/dp_h2">
                <shape android:shape="rectangle">
                    <solid android:color="@color/fragment_all_station_info_list_item_press_color" />
                    <corners android:radius="@dimen/dp_h12" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item android:top="@dimen/dp_h2" android:bottom="@dimen/dp_h2">
                <shape android:shape="rectangle">
                    <solid android:color="@color/fragment_all_station_info_list_item_press_color" />
                    <corners android:radius="@dimen/dp_h12" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <stroke android:width="2.0dip" android:color="@color/focus_line_color" />
            <solid android:color="@color/translucent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/translucent" />
        </shape>
    </item>
</selector>