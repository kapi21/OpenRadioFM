<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:topRightRadius="@dimen/dp_h36" />
            <solid android:color="@color/op_btn_press_color" />
            <gradient android:startColor="@color/op_btn_press_start_color" android:endColor="@color/op_btn_press_color" android:angle="90.0" android:type="linear" android:centerY="0.8" android:centerColor="@color/op_btn_press_center_color" />
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape android:shape="rectangle">
            <corners android:topRightRadius="@dimen/dp_h36" />
            <solid android:color="@color/op_btn_normal_color" />
            <gradient android:startColor="@color/op_btn_normal_start_color" android:endColor="@color/op_btn_normal_color" android:angle="90.0" android:type="linear" android:centerY="0.8" android:centerColor="@color/op_btn_normal_center_color" />
        </shape>
    </item>
</selector>