<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:drawable="@drawable/ic_clear_n" />
            <item>
                <shape>
                    <stroke android:width="2.0dip" android:color="@color/focus_line_color" />
                    <solid android:color="@color/translucent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true" android:drawable="@drawable/ic_clear_d" />
    <item android:drawable="@drawable/ic_clear_n" />
</selector>