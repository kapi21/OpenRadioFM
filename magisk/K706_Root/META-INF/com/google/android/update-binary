#!/sbin/sh

# Magisk module installer entrypoint.
# Compatible con Magisk 20+ (incluye 27.0).
# (LF) Normalizado para instalación en Magisk App.

umask 022

OUTFD="$2"
ZIPFILE="$3"

ui_print() {
  echo -e "ui_print $1\nui_print" > /proc/self/fd/$OUTFD
}

require_new_magisk() {
  ui_print "! Magisk no detectado o demasiado antiguo."
  ui_print "! Instala/actualiza Magisk y reintenta."
  exit 1
}

# Localizar util_functions de Magisk
MAGISKTMP="/data/adb/magisk"
UTIL="$MAGISKTMP/util_functions.sh"

[ -f "$UTIL" ] || require_new_magisk

# shellcheck disable=SC1090
. "$UTIL"

install_module
exit 0

