<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo transparente -->
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    
    <!-- Borde de cristal tallado ultra-fino (0.5dp) -->
    <item>
        <shape>
            <corners android:radius="24dp" />
            <stroke
                android:width="0.5dp"
                android:color="#26FFFFFF" /> <!-- White with 15% Alpha (Hex 26) -->
        </shape>
    </item>
</layer-list>
