<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_grainy_dark">

    <!-- Premium Background Layer (Dynamic Blurred Logo) -->
    <ImageView
        android:id="@+id/ivDynamicBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:alpha="0.25"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Guidelines for Columns (30% | 40% | 30%) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_col1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.30" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_col2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.70" />

    <!-- V20.0: Guideline to avoid frequency overlap with RDS icons in column 2 -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_v1_freq_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.48" />

    <!-- ====================================================================================== -->
    <!-- COLUMN 1: PRESETS (30%) -->
    <!-- ====================================================================================== -->
    <ScrollView
        android:id="@+id/scrollViewPresets"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/layout_v2_screen_edge_padding"
        android:layout_marginEnd="@dimen/layout_v2_column_spacing"
        android:layout_marginTop="@dimen/layout_v2_preset_vertical_margin"
        android:layout_marginBottom="@dimen/layout_v2_preset_vertical_margin"
        android:paddingEnd="0dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_col1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="0dp">

            <!-- Preset Cards Generator -->
            <!-- Inline presets used below to maintain ID compatibility -->
            
            <!-- 
                 Optimization Note: Since we are moving to ConstraintLayout, it would be better 
                 to use a RecyclerView, but to minimize Java changes for now, we will 
                 keep the ScrollView structure but we will have to Inline the cards 
                 or create a separate layout file if we wanted to be clean.
                 
                 However, to avoid creating new files unless necessary, I will keep the 
                 inline LinearLayout definitions for the presets but simplified.
                 
                 Actually, looking at the previous file, there are 12 presets hardcoded. 
                 I will replicate that behavior to maintain ID compatibility.
            -->

            <!-- Preset 1 -->
            <LinearLayout android:id="@+id/cardP1" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP1" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP1" android:text="87.5" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 2 -->
            <LinearLayout android:id="@+id/cardP2" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP2" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP2" android:text="90.0" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 3 -->
            <LinearLayout android:id="@+id/cardP3" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP3" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP3" android:text="100.0" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 4 -->
            <LinearLayout android:id="@+id/cardP4" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP4" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP4" android:text="104.0" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 5 -->
            <LinearLayout android:id="@+id/cardP5" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP5" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP5" android:text="106.0" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 6 -->
            <LinearLayout android:id="@+id/cardP6" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP6" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP6" android:text="108.0" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 7 -->
            <LinearLayout android:id="@+id/cardP7" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP7" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP7" android:text="Empty" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 8 -->
            <LinearLayout android:id="@+id/cardP8" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP8" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP8" android:text="Empty" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 9 -->
            <LinearLayout android:id="@+id/cardP9" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP9" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP9" android:text="Empty" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 10 -->
            <LinearLayout android:id="@+id/cardP10" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP10" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP10" android:text="Empty" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 11 -->
            <LinearLayout android:id="@+id/cardP11" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP11" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP11" android:text="Empty" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 12 -->
            <LinearLayout android:id="@+id/cardP12" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP12" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP12" android:text="Empty" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 13 -->
            <LinearLayout android:id="@+id/cardP13" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP13" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP13" android:text="Empty" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 14 -->
            <LinearLayout android:id="@+id/cardP14" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP14" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP14" android:text="Empty" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 15 -->
            <LinearLayout android:id="@+id/cardP15" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP15" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP15" android:text="Empty" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 16 -->
            <LinearLayout android:id="@+id/cardP16" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP16" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP16" android:text="Empty" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 17 -->
            <LinearLayout android:id="@+id/cardP17" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP17" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP17" android:text="Empty" style="@style/PresetTextStyle"/></LinearLayout>
            <!-- Preset 18 -->
            <LinearLayout android:id="@+id/cardP18" style="@style/PresetCardStyle"><ImageView android:id="@+id/ivP18" style="@style/PresetIconStyle"/><TextView android:id="@+id/tvP18" android:text="Empty" style="@style/PresetTextStyle"/></LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ====================================================================================== -->
    <!-- COLUMN 2: CENTER INFO (40%) -->
    <!-- ====================================================================================== -->
    
    <!-- V18.6: Box Superior para Iconos de Estado -->
	
<FrameLayout
    android:id="@+id/boxIconsTopLayout2"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/bg_glass_card_premium"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toEndOf="@id/guideline_col1"
    app:layout_constraintEnd_toStartOf="@id/guideline_col2">

    <LinearLayout
        android:id="@+id/boxIcons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="20dp"
        android:translationZ="20dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ivBandIndicator"
            android:layout_width="78dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="FM1"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeMaxTextSize="36sp"
            app:autoSizeStepGranularity="2sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ivStereoIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="ST"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeMaxTextSize="24sp"
            app:autoSizeStepGranularity="1sp"
            android:visibility="invisible" />

        <!-- Empuja preset + nube al borde derecho del box; no colapsa si faltan iconos -->
        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">

            <!-- Hueco fijo preset (número); INVISIBLE desde código reserva sitio -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp">
                <ImageView
                    android:id="@+id/ivFavoriteIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.9"
                    android:visibility="invisible"
                    android:scaleType="fitCenter"
                    android:src="@drawable/radio_icon_p01" />
            </FrameLayout>

            <!-- Hueco fijo nube (streaming / datos); no compartir con banda/estéreo -->
            <FrameLayout
                android:id="@+id/ivDataActivity"
                android:layout_width="78dp"
                android:layout_height="52dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="invisible">

                <ImageView
                    android:id="@+id/ivDataActivityIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="2dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@drawable/cloud" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

    <!-- V18.6: Box Central para Frecuencia (Cuerpo visual) -->
    <FrameLayout
        android:id="@+id/boxFrequency"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:background="@drawable/bg_glass_card_premium"
        app:layout_constraintTop_toBottomOf="@id/boxIconsTopLayout2"
        app:layout_constraintStart_toEndOf="@id/guideline_col1"
        app:layout_constraintEnd_toStartOf="@id/guideline_col2"
        app:layout_constraintBottom_toTopOf="@+id/btnSeekDown">

        <!-- Signal: esquina inferior-izquierda (icono o barras según ajustes) -->
        <FrameLayout
            android:id="@+id/frameSignalMeter"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/ivSignalLevel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/level_signal"
                android:visibility="visible" />

            <com.example.openradiofm.ui.widget.SignalBarsView
                android:id="@+id/viewSignalBars"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <!-- MHz/kHz: esquina inferior-derecha -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ivUnitLabel"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="0dp"
            android:translationY="10dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="MHz"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="8sp"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeStepGranularity="1sp" />


        <!-- PTY + RDS Status Icons: Barra inferior distribuida con pesos -->
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="35dp"
        android:layout_marginEnd="70dp"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
    
        <!-- PTY Icon + Text (alineado a la izquierda) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="start|center_vertical">
    
            <TextView
                android:id="@+id/tvPty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="0dp"
                android:text=""
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="start|center_vertical"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:translationY="4dp"
                android:visibility="gone" />
        </LinearLayout>
    
        <!-- RDS Status Icons (AF, TA, TP) alineados a la derecha -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">
    
            <ImageView
                android:id="@+id/ivAfIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:scaleType="fitCenter"
                android:visibility="visible"
                android:alpha="0.2"
                android:src="@drawable/rds_af_n" />
    
            <ImageView
                android:id="@+id/ivTaIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:scaleType="fitCenter"
                android:visibility="visible"
                android:alpha="0.2"
                android:src="@drawable/rds_ta_n" />
    
            <ImageView
                android:id="@+id/ivTpIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:visibility="visible"
                android:alpha="0.2"
                android:src="@drawable/rds_tp_n" />
        </LinearLayout>
      </LinearLayout>
    </FrameLayout>

    <!-- Frecuencia: Movida fuera para forzar el cálculo de ancho de ConstraintLayout -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvFrequency"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:text="100.00"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="0dp"
        android:includeFontPadding="false"
        android:layout_marginBottom="50dp"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="12sp"
        app:autoSizeMaxTextSize="60sp"
        app:autoSizeStepGranularity="2sp"
        android:maxLines="1"
        app:layout_constraintTop_toTopOf="@id/boxFrequency"
        app:layout_constraintBottom_toBottomOf="@id/guideline_v1_freq_bottom"
        app:layout_constraintStart_toStartOf="@id/guideline_col1"
        app:layout_constraintEnd_toEndOf="@id/guideline_col2" />
    
    <!-- V17.1: ivDataActivity se ha vuelto a integrar dentro de boxIcons con posicionamiento corregido -->

    <!-- Seek Buttons -->
    <!-- Navigation & Seek Buttons -->
    <!-- Navigation & Seek Buttons (Classic Layout - Reordered) -->
    <ImageButton
        android:id="@+id/btnSeekDown"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_card_premium"
        android:src="@drawable/seek_down"
        android:scaleType="fitCenter"
        android:padding="14dp"
        app:layout_constraintBottom_toTopOf="@+id/tvRdsInfo"
        app:layout_constraintStart_toEndOf="@id/guideline_col1"
        app:layout_constraintEnd_toStartOf="@+id/btnFavPrev"
        app:layout_constraintHorizontal_weight="1"/>

    <ImageButton
        android:id="@+id/btnFavPrev"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_card_premium"
        android:src="@drawable/btn_previous_n"
        android:scaleType="fitCenter"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tvRdsInfo"
        app:layout_constraintStart_toEndOf="@id/btnSeekDown"
        app:layout_constraintEnd_toStartOf="@+id/btnFavNext"
        app:layout_constraintHorizontal_weight="1"/>

    <ImageButton
        android:id="@+id/btnFavNext"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_card_premium"
        android:src="@drawable/btn_next_n"
        android:scaleType="fitCenter"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tvRdsInfo"
        app:layout_constraintStart_toEndOf="@id/btnFavPrev"
        app:layout_constraintEnd_toStartOf="@+id/btnSeekUp"
        app:layout_constraintHorizontal_weight="1"/>

    <ImageButton
        android:id="@+id/btnSeekUp"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_card_premium"
        android:src="@drawable/seek_up"
        android:scaleType="fitCenter"
        android:padding="14dp"
        app:layout_constraintBottom_toTopOf="@+id/tvRdsInfo"
        app:layout_constraintStart_toEndOf="@+id/btnFavNext"
        app:layout_constraintEnd_toStartOf="@id/guideline_col2"
        app:layout_constraintHorizontal_weight="1"/>

    <!-- V16.2: RDS Name oculto, el nombre se muestra sobre la frecuencia -->
    <TextView
        android:id="@+id/tvRdsName"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:text=""
        app:layout_constraintBottom_toTopOf="@+id/tvRdsInfo"
        app:layout_constraintStart_toEndOf="@id/guideline_col1"
        app:layout_constraintEnd_toStartOf="@id/guideline_col2"/>

    <!-- RDS RT: Ahora ocupa el espacio combinado de ambos boxes RDS -->
    <TextView
        android:id="@+id/tvRdsInfo"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_card_premium"
        android:gravity="center"
        android:text=""
        android:textColor="@color/white"
        android:textSize="20sp"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="16dp"
        android:paddingHorizontal="8dp"
        android:includeFontPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:layout_constraintBottom_toTopOf="@+id/btnBand"
        app:layout_constraintStart_toEndOf="@id/guideline_col1"
        app:layout_constraintEnd_toStartOf="@id/guideline_col2"/>

    <!-- Band & Scan -->
    <ImageButton
        android:id="@+id/btnBand"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_card_premium"
        android:src="@drawable/radio_band_n"
        android:scaleType="fitCenter"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline_col1"
        app:layout_constraintEnd_toStartOf="@+id/boxAutoScan"
        app:layout_constraintHorizontal_weight="1"/>

        <!-- Contenedor fijo: el skin/cristal no gira con el icono durante autoscan -->
        <FrameLayout
            android:id="@+id/boxAutoScan"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_glass_card_premium"
            android:clickable="false"
            android:focusable="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnBand"
            app:layout_constraintEnd_toStartOf="@+id/btnLocDx"
            app:layout_constraintHorizontal_weight="1">

            <ImageButton
                android:id="@+id/btnAutoScan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/radio_scan_icon_f"
                android:scaleType="fitCenter"
                android:padding="16dp" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/btnLocDx"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_glass_card_premium"
            android:src="@drawable/radio_loc_n"
            android:scaleType="fitCenter"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/boxAutoScan"
            app:layout_constraintEnd_toStartOf="@id/guideline_col2"
            app:layout_constraintHorizontal_weight="1"/>

    <!-- ====================================================================================== -->
    <!-- COLUMN 3: LOGO & EXTRAS (30%) -->
    <!-- ====================================================================================== -->

    <!-- Logo Box (Matches Frequency Box Height strictly) -->
    <LinearLayout
        android:id="@+id/boxLogo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_glass_card_premium"
        android:layout_marginStart="@dimen/layout_v2_column_spacing"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/layout_v2_screen_edge_padding"
        android:layout_marginBottom="8dp"
        android:padding="16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnSeekDown"
        app:layout_constraintStart_toEndOf="@id/guideline_col2"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivMainLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />
    </LinearLayout>


    <!-- Controls Row 1 (Android/Save) - WEIGHTED CHAIN -->
    <ImageButton 
        android:id="@+id/btnExtra1" 
        android:layout_width="0dp" 
        android:layout_height="0dp" 
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp" 
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_glass_card_premium" 
        android:src="@drawable/ic_android_settings" 
        android:scaleType="fitCenter" 
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/boxLogo"
        app:layout_constraintBottom_toTopOf="@+id/btnMute"
        app:layout_constraintStart_toEndOf="@id/guideline_col2" 
        app:layout_constraintEnd_toStartOf="@+id/btnExtra2"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintHorizontal_weight="1"/>
        
    <ImageButton 
        android:id="@+id/btnExtra2" 
        android:layout_width="0dp" 
        android:layout_height="0dp"
        android:layout_marginStart="4dp" 
        android:layout_marginEnd="@dimen/layout_v2_screen_edge_padding"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_glass_card_premium" 
        android:src="@drawable/ic_save_load" 
        android:scaleType="fitCenter" 
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/boxLogo"
        app:layout_constraintBottom_toTopOf="@+id/btnGps"
        app:layout_constraintStart_toEndOf="@+id/btnExtra1" 
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintHorizontal_weight="1"/>

    <!-- Controls Row 2 (Loc/Mute) - WEIGHTED CHAIN -->
    <ImageButton 
        android:id="@+id/btnMute" 
        android:layout_width="0dp" 
        android:layout_height="0dp" 
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp" 
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_glass_card_premium" 
        android:src="@drawable/radio_mute_n" 
        android:scaleType="fitCenter" 
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/btnExtra1"
        app:layout_constraintBottom_toTopOf="@+id/btnSettings"
        app:layout_constraintStart_toEndOf="@id/guideline_col2" 
        app:layout_constraintEnd_toStartOf="@+id/btnGps"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintHorizontal_weight="1"/>
        
    <ImageButton 
        android:id="@+id/btnGps" 
        android:layout_width="0dp" 
        android:layout_height="0dp" 
        android:layout_marginStart="4dp" 
        android:layout_marginEnd="@dimen/layout_v2_screen_edge_padding"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_glass_card_premium" 
        android:src="@drawable/radio_gps" 
        android:scaleType="fitCenter" 
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/btnExtra2"
        app:layout_constraintBottom_toTopOf="@+id/btnPowerOff"
        app:layout_constraintStart_toEndOf="@+id/btnMute" 
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintHorizontal_weight="1"/>

    <!-- Controls Row 3 (Settings/PowerOff) - WEIGHTED CHAIN -->
    <ImageButton 
        android:id="@+id/btnSettings" 
        android:layout_width="0dp" 
        android:layout_height="0dp" 
        android:layout_marginStart="8dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp" 
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_glass_card_premium" 
        android:src="@drawable/radio_eq_n" 
        android:scaleType="fitCenter" 
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/btnMute"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline_col2" 
        app:layout_constraintEnd_toStartOf="@+id/btnPowerOff"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintHorizontal_weight="1"/>
        
    <ImageButton 
        android:id="@+id/btnPowerOff" 
        android:layout_width="0dp" 
        android:layout_height="0dp" 
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/layout_v2_screen_edge_padding"
        android:layout_marginBottom="8dp" 
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_glass_card_premium" 
        android:src="@drawable/power_off" 
        android:scaleType="fitCenter" 
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@+id/btnGps"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnSettings" 
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="1"
        app:layout_constraintHorizontal_weight="1"/>

</androidx.constraintlayout.widget.ConstraintLayout>
