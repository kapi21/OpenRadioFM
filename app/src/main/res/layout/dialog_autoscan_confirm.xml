<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="500dp"
    android:layout_height="wrap_content"
    android:background="#E6121212"
    android:padding="16dp"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/autoscan_dialog_root"
        style="@style/DialogContainerStyle">

        <LinearLayout
            style="@style/DialogTitleLayout"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null"
                android:src="@drawable/radio_scan_icon_f" />

            <TextView
                android:id="@+id/tvAutoscanTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/autoscan_confirm_title"
                android:textColor="#00E676"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/DialogSubheaderText"
            android:layout_marginTop="0dp"
            android:text="@string/autoscan_confirm_subheader"
            tools:text="AVISO" />

        <LinearLayout
            style="@style/DialogBoxStyle"
            android:clickable="false"
            android:focusable="false">

            <TextView
                android:id="@+id/tvAutoscanMessage"
                style="@style/DialogBoxDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/autoscan_confirm_message"
                android:textColor="@color/white"
                android:textSize="15sp"
                tools:text="Mensaje…" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAutoscanCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card_red"
                android:minHeight="52dp"
                android:text="@string/cancel"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAutoscanStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_submenu_box"
                android:backgroundTint="#00E676"
                android:minHeight="52dp"
                android:text="@string/autoscan_confirm_start"
                android:textAllCaps="true"
                android:textColor="#FF121212"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
