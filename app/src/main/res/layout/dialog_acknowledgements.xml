<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="460dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_card_premium"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvAckTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agradecimientos"
        android:textColor="#00E676"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Grupo telegram "
        android:textColor="#DDDDDD"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvRadioAndroidLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Radio Android España"
        android:textColor="#4DA3FF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:background="?android:attr/selectableItemBackground" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="(a sus admins y a sus usuarios testeadores)."
        android:textColor="#CCCCCC"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnCloseAcknowledgements"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="18dp"
        android:text="Cerrar"
        android:textColor="#FFD600"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="10dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
