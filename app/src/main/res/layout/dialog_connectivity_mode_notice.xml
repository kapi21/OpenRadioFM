<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="540dp"
    android:layout_height="wrap_content"
    android:background="#E6121212"
    android:padding="16dp"
    android:scrollbars="none">

    <LinearLayout style="@style/DialogContainerStyle">

        <!-- Title -->
        <LinearLayout
            style="@style/DialogTitleLayout"
            android:gravity="center"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connectivity_notice_title"
                android:textColor="#00E676"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Message -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connectivity_notice_message"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:layout_marginBottom="14dp" />

        <!-- Card 1: Offline Mode -->
        <LinearLayout
            android:id="@+id/cardOfflineMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_connectivity_card_unselected"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvCardOfflineTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/offline_mode_title"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <RadioButton
                    android:id="@+id/rbOfflineMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connectivity_notice_offline_desc"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Card 2: Online Mode -->
        <LinearLayout
            android:id="@+id/cardOnlineMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_connectivity_card_unselected"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvCardOnlineTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/connectivity_notice_online_btn"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <RadioButton
                    android:id="@+id/rbOnlineMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connectivity_notice_online_desc"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Footer / Hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connectivity_notice_footer"
            android:textColor="#777777"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Confirm Button -->
        <TextView
            android:id="@+id/btnConfirmMode"
            style="@style/DialogCloseButton"
            android:backgroundTint="#00E676"
            android:textColor="#000000"
            android:text="@string/connectivity_notice_confirm"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>
