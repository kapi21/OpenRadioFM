<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="K706 ENGINEERING (PREMIUM)"
                android:textColor="#00E676"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvK706Version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="V9.5"
                android:textColor="#80FFFFFF"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnCloseK706"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="✕"
                android:textColor="#FF5252"
                android:textSize="20sp"
                android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>

        <!-- MONITOR EN TIEMPO REAL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LIVE STATUS"
            android:textColor="#FFD600"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvK706Monitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FREQ: ---\nBAND: ---\nFLAGS: ---\nPTY: ---\nPS: ---\nRT: ---"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:background="#222222"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <!-- TUNER COMMANDS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RADIO TUNER"
            android:textColor="#FFD600"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button android:id="@+id/btnK706FineDown"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="◀ FINE"
                android:textSize="12sp" android:textColor="#FFFFFF"
                android:background="#333333" android:layout_marginEnd="4dp" />

            <Button android:id="@+id/btnK706FineUp"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="FINE ▶"
                android:textSize="12sp" android:textColor="#FFFFFF"
                android:background="#333333" android:layout_marginEnd="4dp" />

            <Button android:id="@+id/btnK706SeekDown"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="◀ SEEK"
                android:textSize="12sp" android:textColor="#00E676"
                android:background="#333333" android:layout_marginEnd="4dp" />

            <Button android:id="@+id/btnK706SeekUp"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="SEEK ▶"
                android:textSize="12sp" android:textColor="#00E676"
                android:background="#333333" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button android:id="@+id/btnK706AutoScan"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="AUTOSCAN"
                android:textSize="12sp" android:textColor="#FFD600"
                android:background="#333333" android:layout_marginEnd="4dp" />

            <Button android:id="@+id/btnK706StopScan"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="STOP SCAN"
                android:textSize="12sp" android:textColor="#FF5252"
                android:background="#333333" android:layout_marginEnd="4dp" />

            <Button android:id="@+id/btnK706SavePreset"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="SAVE PRESET"
                android:textSize="12sp" android:textColor="#FFFFFF"
                android:background="#333333" />
        </LinearLayout>

        <!-- BAND SELECT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BAND / LOC"
            android:textColor="#FFD600"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button android:id="@+id/btnK706Band"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="BAND ▶"
                android:textSize="12sp" android:textColor="#FFFFFF"
                android:background="#333333" android:layout_marginEnd="4dp" />

            <Button android:id="@+id/btnK706LocDx"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="LOC/DX"
                android:textSize="12sp" android:textColor="#29B6F6"
                android:background="#333333" android:layout_marginEnd="4dp" />

            <Button android:id="@+id/btnK706Area0"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="AREA:0"
                android:textSize="12sp" android:textColor="#80FFFFFF"
                android:background="#333333" android:layout_marginEnd="4dp" />

            <Button android:id="@+id/btnK706Area1"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="AREA:1"
                android:textSize="12sp" android:textColor="#80FFFFFF"
                android:background="#333333" />
        </LinearLayout>

        <!-- RDS SETTINGS MOVED TO PREMIUM SETTINGS MENU -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button android:id="@+id/btnK706PtyReset"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="PTY RESET"
                android:textSize="12sp" android:textColor="#FFD600"
                android:background="#333333" android:layout_marginEnd="4dp" />

            <Button android:id="@+id/btnK706PtyNews"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="PTY:NEWS"
                android:textSize="12sp" android:textColor="#80FFFFFF"
                android:background="#333333" />
        </LinearLayout>

        <!-- AUDIO CHANNEL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AUDIO ROUTING"
            android:textColor="#FFD600"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button android:id="@+id/btnK706Ch1"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="CH1:BT"
                android:textSize="12sp" android:textColor="#FFFFFF"
                android:background="#333333" android:layout_marginEnd="4dp" />

            <Button android:id="@+id/btnK706Ch2"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="CH2:FM"
                android:textSize="12sp" android:textColor="#00E676"
                android:background="#333333" android:layout_marginEnd="4dp" />

            <Button android:id="@+id/btnK706Ch3"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="CH3:AUX"
                android:textSize="12sp" android:textColor="#FFFFFF"
                android:background="#333333" android:layout_marginEnd="4dp" />

            <Button android:id="@+id/btnK706Ch4"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="CH4:AND"
                android:textSize="12sp" android:textColor="#FFFFFF"
                android:background="#333333" />
        </LinearLayout>

        <!-- MCU RAW LOG -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RAW MCU LOG"
            android:textColor="#FFD600"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp" />

        <ScrollView
            android:id="@+id/scrollK706Log"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#111111"
            android:padding="8dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvK706Log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#00E676"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp" />
        </ScrollView>

        <!-- EXIT -->
        <Button
            android:id="@+id/btnK706Exit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CLOSE ENGINEERING DEV"
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="#222222"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>

