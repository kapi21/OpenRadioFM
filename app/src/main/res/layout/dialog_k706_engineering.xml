<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:padding="24dp">

    <!-- HEADER: TERMINAL STYLE -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="> K706_ENGINEERING_MATRIX_V10.0"
        android:textColor="#00FF00"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Close Button -->
    <ImageButton
        android:id="@+id/btnCloseK706"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#00FF00"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- MAIN SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/scrollK706Log"
        app:layout_constraintTop_toBottomOf="@id/tvHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SECTION: RADIO TUNER DATA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ RADIO_TUNER_DATA_RAW ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="8dp">

                <TextView android:text="SIGNAL_STRENGTH" style="@style/EngLabelStyle"/>
                <TextView
                    android:id="@+id/tvK706SignalStrengthBar"
                    style="@style/EngValueStyle"
                    android:text="[-90dBm] .........." />

                <TextView android:text="MCU_RSSI_SNR" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706RawSignal" android:text="0x00 / 0x00" style="@style/EngValueStyle"/>

                <TextView android:text="STEREO_STATUS" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706Stereo" android:text="MONO" style="@style/EngValueStyle"/>

                <TextView android:text="TUNER_BAND" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706BandInfo" android:text="FM1" style="@style/EngValueStyle"/>
                
                <TextView android:text="SCAN_STATUS" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706Scan" android:text="IDLE" style="@style/EngValueStyle"/>
            </GridLayout>

            <!-- SECTION: TUNER COMMANDS (REQUESTED) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="[ TUNER_HARDWARE_CONTROLS ]"
                android:textColor="#00FF00"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:gravity="center"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center">

                <Button android:id="@+id/btnK706SeekDown"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="SEEK &lt;&lt; "
                    android:textSize="11sp" android:textColor="#00FF00"
                    android:backgroundTint="#002200" android:layout_marginEnd="4dp" />

                <Button android:id="@+id/btnK706FineDown"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="STEP &lt;"
                    android:textSize="11sp" android:textColor="#00FF00"
                    android:backgroundTint="#002200" android:layout_marginEnd="4dp" />

                <Button android:id="@+id/btnK706FineUp"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="STEP &gt;"
                    android:textSize="11sp" android:textColor="#00FF00"
                    android:backgroundTint="#002200" android:layout_marginEnd="4dp" />

                <Button android:id="@+id/btnK706SeekUp"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="SEEK &gt;&gt;"
                    android:textSize="11sp" android:textColor="#00FF00"
                    android:backgroundTint="#002200" />
            </LinearLayout>

            <!-- V24.5: SECTION: HARDWARE_AUTOMATION_MODULE (K706 Exclusive) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ HARDWARE_AUTOMATION_MODULE ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAutoNightHw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AUTO_NIGHT_MODE (LIGHTS_SENSE)"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace"
                    app:thumbTint="#00FF00"
                    app:trackTint="#3300FF00" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swReverseMuteHw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="REVERSE_GEAR_MUTE (CAMERA_SYNC)"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace"
                    app:thumbTint="#00FF00"
                    app:trackTint="#3300FF00" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swHandbrakeHw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="HANDBRAKE_SENSE (SAFETY_LOCK)"
                    android:textColor="#FFFFFF"
                    android:fontFamily="monospace"
                    app:thumbTint="#00FF00"
                    app:trackTint="#3300FF00" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <TextView android:text="ACC_STATUS (0x24): " style="@style/EngLabelStyle" android:layout_weight="1"/>
                    <TextView android:id="@+id/tvK706Acc" android:text="UNKNOWN" style="@style/EngValueStyle" android:textColor="#FFFF00"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="NOTE: ACTIVATION ENABLES OPTIONS IN MAIN SETTINGS MENU."
                    android:textColor="#88FF88"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- SECTION: RDS DECODER DATA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ RDS_DECODER_RAW_METRICS ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="8dp">

                <TextView android:text="PROGRAM_SERVICE" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706Ps" android:text="NONE" style="@style/EngValueStyle"/>

                <TextView android:text="RADIO_TEXT" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706Rt" android:text="WAITING..." style="@style/EngValueStyle"/>

                <TextView android:text="RT_RAW_DATA" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706RtRaw" android:text="NONE" style="@style/EngValueStyle" android:textSize="10sp"/>

                <TextView android:text="PI_CODE (HEX)" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706Pi" android:text="0000" style="@style/EngValueStyle"/>

                <TextView android:text="PTY_CODE" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706Pty" android:text="00" style="@style/EngValueStyle"/>

                <TextView android:text="SIGNAL_RSSI" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706RssiValue" android:text="--" style="@style/EngValueStyle"/>

                <TextView android:text="SIGNAL_SNR" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706Snr" android:text="--" style="@style/EngValueStyle"/>

                <TextView android:text="SIGNAL_USN" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706Usn" android:text="--" style="@style/EngValueStyle"/>
            </GridLayout>

            <!-- SECTION: DEV TOGGLES (GROUPED) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ DEV_TOGGLES_UI ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDevAutoScanEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/eng_dev_autoscan_toggle"
                android:textColor="#00FF00"
                android:fontFamily="monospace"
                app:thumbTint="#00FF00"
                app:trackTint="#3300FF00" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDevDayModeEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/eng_dev_day_mode_killswitch"
                android:textColor="#00FF00"
                android:fontFamily="monospace"
                app:thumbTint="#00FF00"
                app:trackTint="#3300FF00" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDevReliefHdEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/eng_dev_relief_hd_killswitch"
                android:textColor="#00FF00"
                android:fontFamily="monospace"
                app:thumbTint="#00FF00"
                app:trackTint="#3300FF00" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDevFileLoggingEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/eng_dev_file_log_toggle"
                android:textColor="#00FF00"
                android:fontFamily="monospace"
                app:thumbTint="#00FF00"
                app:trackTint="#3300FF00" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eng_dev_file_log_profile_label"
                    android:textColor="#88FF88"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="10dp"/>

                <SeekBar
                    android:id="@+id/sbDevFileLogProfile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="2"
                    android:progress="0" />

                <TextView
                    android:id="@+id/tvDevFileLogProfileValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="70dp"
                    android:gravity="center"
                    android:text="@string/eng_dev_file_log_profile_basic"
                    android:textColor="#00FF00"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/eng_dev_autoscan_threshold_label"
                android:textColor="#88FF88"
                android:textSize="11sp"
                android:fontFamily="monospace"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <SeekBar
                    android:id="@+id/sbDevAutoScanThreshold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="15"
                    android:progress="2" />

                <TextView
                    android:id="@+id/tvDevAutoScanThresholdValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="28dp"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#00FF00"
                    android:textSize="14sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- V24.8: TUNER SENSITIVITY (DX/LOC THRESHOLD) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="TUNER_SEEK_SENSITIVITY (SQUELCH)"
                android:textColor="#88FF88"
                android:textSize="11sp"
                android:fontFamily="monospace"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <SeekBar
                    android:id="@+id/sbK706Sensitivity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="15"
                    android:progress="0" />

                <TextView
                    android:id="@+id/tvK706SensitivityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="28dp"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="#00FF00"
                    android:textSize="14sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- SECTION: OEM MEDIA / AUDIOFOCUS STATUS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ OEM_MEDIA_SESSION_STATUS ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="8dp">

                <TextView android:text="LAST_FOCUS_EVENT" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706OemFocusEvent" android:text="N/A" style="@style/EngValueStyle"/>

                <TextView android:text="OEM_FLAGS" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706OemFlags" android:text="N/A" style="@style/EngValueStyle"/>
            </GridLayout>

            <!-- SECTION: FILE SYSTEM & ASSETS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ FILE_SYSTEM_INTEGRITY ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tvK706Assets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:text="CHECKING RadioLogos folder..."/>

            <!-- SECTION: SYSTEM METRICS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ ANDROID_OS_DIAGNOSTICS ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="8dp">

                <TextView android:text="MCU_COMMAND_RAW" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706McuRaw" android:text="NONE" style="@style/EngValueStyle"/>

                <TextView android:text="DEVICE_MODEL" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvK706Device" android:text="UNKNOWN" style="@style/EngValueStyle"/>
            </GridLayout>

        </LinearLayout>
    </ScrollView>

    <!-- LIVE TERMINAL LOG -->
    <ScrollView
        android:id="@+id/scrollK706Log"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#2200FF00"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnK706Exit">
        <TextView
            android:id="@+id/tvK706Log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textColor="#00FF00"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:text="[MCU] SYNCING..."/>
    </ScrollView>

    <!-- EXIT BUTTON -->
    <Button
        android:id="@+id/btnK706Exit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[ TERMINATE_K706_ENGINEERING ]"
        android:fontFamily="monospace"
        android:textColor="#FF0000"
        android:backgroundTint="#220000"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
