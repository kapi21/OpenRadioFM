<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:padding="24dp">

    <!-- HEADER: TERMINAL STYLE -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="> ENGINEERING_MODE_MATRIX_V5.1"
        android:textColor="#00FF00"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Close Button -->
    <ImageButton
        android:id="@+id/btnCloseEng"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#00FF00"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- MAIN SCROLLABLE CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/scrollLog"
        app:layout_constraintTop_toBottomOf="@id/tvHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SECTION: RADIO TUNER DATA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ RADIO_TUNER_DATA_RAW ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="8dp">

                <TextView android:text="SIGNAL_STRENGTH" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvRssiBar" android:text="[-90dBm] ░░░░░░░░░░" style="@style/EngValueStyle"/>

                <TextView android:text="SIGNAL_QUALITY" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvSignalQualityIndex" android:text="0%" style="@style/EngValueStyle"/>

                <TextView android:text="STEREO_STATUS" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvStereoPilot" android:text="MONO" style="@style/EngValueStyle"/>

                <TextView android:text="TUNER_MODE" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvTunerMode" android:text="DX" style="@style/EngValueStyle"/>
                
                <TextView android:text="RADIO_ENGINE" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvChipset" android:text="DETECTING..." style="@style/EngValueStyle"/>
            </GridLayout>

            <!-- SECTION: RDS DECODER DATA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ RDS_DECODER_RAW_METRICS ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="8dp">

                <TextView android:text="PROGRAM_SERVICE" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvPsName" android:text="NONE" style="@style/EngValueStyle"/>

                <TextView android:text="RADIO_TEXT" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvRtText" android:text="WAITING DATA..." style="@style/EngValueStyle"/>

                <TextView android:text="PI_CODE (HEX)" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvPiCode" android:text="0000" style="@style/EngValueStyle"/>

                <TextView android:text="PTY_CODE" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvPtyRaw" android:text="00" style="@style/EngValueStyle"/>

                <TextView android:text="SYNC_STATUS" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvRdsSync" android:text="NO_SYNC" style="@style/EngValueStyle"/>

                <TextView android:text="AF_LIST" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvAfList" android:text="EMPTY" style="@style/EngValueStyle"/>
            </GridLayout>

            <!-- SECTION: FILE SYSTEM & ASSETS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ FILE_SYSTEM_INTEGRITY ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tvAssetsInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:text="CHECKING /sdcard/RadioLogos..."/>

            <!-- SECTION: SYSTEM METRICS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ ANDROID_OS_DIAGNOSTICS ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="8dp">

                <TextView android:text="SERVICE_LATENCY" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvServiceLatency" android:text="0.00ms" style="@style/EngValueStyle"/>

                <TextView android:text="MEMORY_HEAP" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvMemoryUsage" android:text="0MB / 0MB" style="@style/EngValueStyle"/>

                <TextView android:text="DEVICE_MODEL" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvDeviceInfo" android:text="UNKNOWN" style="@style/EngValueStyle"/>

                <TextView android:text="ROOT_LEVEL" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvRootStatus" android:text="CHECKING..." style="@style/EngValueStyle"/>
            </GridLayout>

            <!-- TUNER CONTROLS (MINIMAL) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center">
                
                <Button
                    android:id="@+id/btnTuneDown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&lt;&lt; TUNE"
                    android:fontFamily="monospace"
                    android:backgroundTint="#003300"
                    android:textColor="#00FF00"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnTuneUp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TUNE &gt;&gt;"
                    android:fontFamily="monospace"
                    android:backgroundTint="#003300"
                    android:textColor="#00FF00"/>
            </LinearLayout>

            <!-- DEV TOGGLES (MT8163) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ DEV_TOGGLES_MT8163 ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swMt8163GlobalStreamMute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Legacy: mutear STREAM_MUSIC (silencia todo el sistema)"
                android:textColor="#00FF00"
                android:fontFamily="monospace"
                app:thumbTint="#00FF00"
                app:trackTint="#3300FF00" />

        </LinearLayout>
    </ScrollView>

    <!-- LIVE TERMINAL LOG -->
    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#2200FF00"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnExitSystem">
        <TextView
            android:id="@+id/tvTerminalLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textColor="#00FF00"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:text="[KERNEL] SYNC..."/>
    </ScrollView>

    <!-- EXIT BUTTON -->
    <Button
        android:id="@+id/btnExitSystem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[ TERMINATE_ENGINEERING_SESSION ]"
        android:fontFamily="monospace"
        android:textColor="#FF0000"
        android:backgroundTint="#220000"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
