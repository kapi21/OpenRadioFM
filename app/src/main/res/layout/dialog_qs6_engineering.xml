<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvQs6Header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="> QS6_NWD_ENGINEERING_MATRIX_V1"
        android:textColor="#00FF00"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnCloseQs6"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="#00FF00"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/scrollQs6Log"
        app:layout_constraintTop_toBottomOf="@id/tvQs6Header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- NWD / AIDL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ NWD_QS6_STACK / AIDL ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="8dp">

                <TextView android:text="NWD_SERVICE_BIND" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6NwdBind" android:text="..." style="@style/EngValueStyle"/>

                <TextView android:text="AF / TA / TP" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6RdsFlags" android:text="..." style="@style/EngValueStyle"/>
            </GridLayout>

            <!-- RF -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ RADIO_TUNER_DATA_RAW ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="8dp">

                <TextView android:text="SIGNAL_ESTIMATE" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6Rssi" android:text="[---] ░░░░░░░░░░" style="@style/EngValueStyle"/>

                <TextView android:text="STEREO_UI" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6StereoUi" android:text="MONO" style="@style/EngValueStyle"/>

                <TextView android:text="PILOT / DECODER" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6StereoRaw" android:text="..." style="@style/EngValueStyle"/>

                <TextView android:text="TUNER_BAND" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6BandInfo" android:text="0" style="@style/EngValueStyle"/>

                <TextView android:text="SCAN_STATUS" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6Scan" android:text="IDLE" style="@style/EngValueStyle"/>

                <TextView android:text="DX_LOCAL_MODE" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6DxLocal" android:text="DX" style="@style/EngValueStyle"/>
            </GridLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="[ TUNER + NWD_ACTIONS ]"
                android:textColor="#00FF00"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:gravity="center"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center">

                <Button android:id="@+id/btnQs6SeekDown"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="SEEK &lt;&lt;"
                    android:textSize="11sp" android:textColor="#00FF00"
                    android:backgroundTint="#002200" android:layout_marginEnd="4dp" />

                <Button android:id="@+id/btnQs6FineDown"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="STEP &lt;"
                    android:textSize="11sp" android:textColor="#00FF00"
                    android:backgroundTint="#002200" android:layout_marginEnd="4dp" />

                <Button android:id="@+id/btnQs6FineUp"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="STEP &gt;"
                    android:textSize="11sp" android:textColor="#00FF00"
                    android:backgroundTint="#002200" android:layout_marginEnd="4dp" />

                <Button android:id="@+id/btnQs6SeekUp"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="SEEK &gt;&gt;"
                    android:textSize="11sp" android:textColor="#00FF00"
                    android:backgroundTint="#002200" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center">

                <Button android:id="@+id/btnQs6OpenEq"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="OPEN_EQ_OEM"
                    android:textSize="11sp" android:textColor="#00FFFF"
                    android:backgroundTint="#002222" android:layout_marginEnd="4dp" />

                <Button android:id="@+id/btnQs6WakeNwd"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="WAKE_NWD"
                    android:textSize="11sp" android:textColor="#FFFF00"
                    android:backgroundTint="#222200" />
            </LinearLayout>

            <!-- QS6: KernelService MCU (experimental) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#3322AAFF"
                android:padding="4dp"
                android:text="[ QS6_MCU_KERNELSERVICE (EXPERIMENTAL) ]"
                android:textColor="#88CCFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="8dp">

                <TextView android:text="KERNEL_BIND" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6KernelBind" android:text="DISCONNECTED" style="@style/EngValueStyle"/>

                <TextView android:text="LAST_MCU_CMD" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6KernelLastCmd" android:text="-" style="@style/EngValueStyle"/>
            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btnQs6KernelBind"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="BIND_KERNEL"
                    android:textSize="11sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQs6KernelInfo"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="RADIO_INFO"
                    android:textSize="11sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btnQs6KernelBackOn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="BACK_ON"
                    android:textSize="11sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQs6KernelBackOff"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="BACK_OFF"
                    android:textSize="11sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btnQs6KernelSeekDown"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="STEP_0.5 &lt;&lt;"
                    android:textSize="11sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQs6KernelSeekUp"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="STEP_0.5 &gt;&gt;"
                    android:textSize="11sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btnQs6KernelSearchDown"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="SEEK_STN &lt;&lt;"
                    android:textSize="11sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQs6KernelSearchUp"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="SEEK_STN &gt;&gt;"
                    android:textSize="11sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btnQs6KernelBand"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="BAND_CYC"
                    android:textSize="11sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQs6KernelAms"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="AMS (FUERTE)"
                    android:textSize="11sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btnQs6KernelTune875"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="TUNE 87.5"
                    android:textSize="11sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQs6KernelTune1015"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="TUNE 101.5"
                    android:textSize="11sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btnQs6KernelIntro"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="INTRO"
                    android:textSize="10sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQs6KernelNearDx"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="NEAR_DX"
                    android:textSize="10sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQs6KernelNearLoc"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="NEAR_LOC"
                    android:textSize="10sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btnQs6KernelRdsShow"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="RDS_SHOW"
                    android:textSize="10sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQs6KernelRds0"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="RDS=0"
                    android:textSize="10sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQs6KernelRds7"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="RDS=7"
                    android:textSize="10sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btnQs6KernelRdsXor1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="RDS^1"
                    android:textSize="10sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQs6KernelRdsXor2"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="RDS^2"
                    android:textSize="10sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQs6KernelRdsXor4"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="RDS^4"
                    android:textSize="10sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btnQs6KernelPtyDown"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="PTY &lt;&lt;"
                    android:textSize="10sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQs6KernelPtyUp"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="PTY &gt;&gt;"
                    android:textSize="10sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnQs6KernelSaveP1"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="SAVE_P1"
                    android:textSize="10sp"
                    android:textColor="#88CCFF"
                    android:backgroundTint="#001933" />
            </LinearLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:columnCount="4"
                android:padding="2dp">

                <Button android:id="@+id/btnQs6KernelSaveP2" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="P2" android:textSize="10sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>
                <Button android:id="@+id/btnQs6KernelSaveP3" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="P3" android:textSize="10sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>
                <Button android:id="@+id/btnQs6KernelSaveP4" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="P4" android:textSize="10sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>
                <Button android:id="@+id/btnQs6KernelSaveP5" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="P5" android:textSize="10sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>

                <Button android:id="@+id/btnQs6KernelSaveP6" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="P6" android:textSize="10sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>
                <Button android:id="@+id/btnQs6KernelSaveP7" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="P7" android:textSize="10sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>
                <Button android:id="@+id/btnQs6KernelSaveP8" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="P8" android:textSize="10sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>
                <Button android:id="@+id/btnQs6KernelSaveP9" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="P9" android:textSize="10sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>

                <Button android:id="@+id/btnQs6KernelSaveP10" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="P10" android:textSize="10sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>
                <Button android:id="@+id/btnQs6KernelSaveP11" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="P11" android:textSize="10sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>
                <Button android:id="@+id/btnQs6KernelSaveP12" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="P12" android:textSize="10sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>
                <Button android:id="@+id/btnQs6KernelSaveP13" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="P13" android:textSize="10sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>

                <Button android:id="@+id/btnQs6KernelSaveP14" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="P14" android:textSize="10sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>
                <Button android:id="@+id/btnQs6KernelSaveP15" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="P15" android:textSize="10sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>
                <Button android:id="@+id/btnQs6KernelSaveP16" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="P16" android:textSize="10sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>
                <Button android:id="@+id/btnQs6KernelSavePAll" android:layout_width="0dp" android:layout_height="36dp" android:layout_columnWeight="1" android:text="SAVE_ALL" android:textSize="9sp" android:textColor="#88CCFF" android:backgroundTint="#001933"/>
            </GridLayout>

            <!-- AIDL RadioFeature (NWD) - para sustituir app nativa -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#3344FF88"
                android:padding="4dp"
                android:text="[ QS6_RADIOFEATURE_AIDL (TEST) ]"
                android:textColor="#88FF88"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center">
                <Button android:id="@+id/btnQs6AidlRefresh" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="AIDL_REFRESH" android:textSize="10sp" android:textColor="#88FF88" android:backgroundTint="#002211" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btnQs6AidlIntro" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="AIDL_INTRO" android:textSize="10sp" android:textColor="#88FF88" android:backgroundTint="#002211"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center">
                <Button android:id="@+id/btnQs6AidlStereoOn" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="STEREO_ON" android:textSize="10sp" android:textColor="#88FF88" android:backgroundTint="#002211" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btnQs6AidlStereoOff" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="STEREO_OFF" android:textSize="10sp" android:textColor="#88FF88" android:backgroundTint="#002211"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center">
                <Button android:id="@+id/btnQs6AidlPrefPrev" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="PREFEB &lt;&lt;" android:textSize="10sp" android:textColor="#88FF88" android:backgroundTint="#002211" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btnQs6AidlPrefNext" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="PREFEB &gt;&gt;" android:textSize="10sp" android:textColor="#88FF88" android:backgroundTint="#002211"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center">
                <Button android:id="@+id/btnQs6ShadowStopSearch" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="STOP_SEARCH" android:textSize="10sp" android:textColor="#FFFFAA" android:backgroundTint="#222200"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ DEV_TOGGLES_UI ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDevAutoScanEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/eng_dev_autoscan_toggle"
                android:textColor="#00FF00"
                android:fontFamily="monospace"
                app:thumbTint="#00FF00"
                app:trackTint="#3300FF00" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDevDayModeEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/eng_dev_day_mode_killswitch"
                android:textColor="#00FF00"
                android:fontFamily="monospace"
                app:thumbTint="#00FF00"
                app:trackTint="#3300FF00" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDevReliefHdEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/eng_dev_relief_hd_killswitch"
                android:textColor="#00FF00"
                android:fontFamily="monospace"
                app:thumbTint="#00FF00"
                app:trackTint="#3300FF00" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swDevFileLoggingEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/eng_dev_file_log_toggle"
                android:textColor="#00FF00"
                android:fontFamily="monospace"
                app:thumbTint="#00FF00"
                app:trackTint="#3300FF00" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/eng_dev_file_log_profile_label"
                    android:textColor="#88FF88"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginEnd="10dp"/>

                <SeekBar
                    android:id="@+id/sbDevFileLogProfile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="2"
                    android:progress="0" />

                <TextView
                    android:id="@+id/tvDevFileLogProfileValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="70dp"
                    android:gravity="center"
                    android:text="@string/eng_dev_file_log_profile_basic"
                    android:textColor="#00FF00"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/eng_dev_autoscan_threshold_label"
                android:textColor="#88FF88"
                android:textSize="11sp"
                android:fontFamily="monospace"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <SeekBar
                    android:id="@+id/sbDevAutoScanThreshold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="15"
                    android:progress="2" />

                <TextView
                    android:id="@+id/tvDevAutoScanThresholdValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="28dp"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="#00FF00"
                    android:textSize="14sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <!-- RDS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ RDS_DECODER_RAW_METRICS ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="8dp">

                <TextView android:text="PROGRAM_SERVICE" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6Ps" android:text="NONE" style="@style/EngValueStyle"/>

                <TextView android:text="RADIO_TEXT" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6Rt" android:text="WAITING..." style="@style/EngValueStyle"/>

                <TextView android:text="PI_CODE (HEX)" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6Pi" android:text="0000" style="@style/EngValueStyle"/>

                <TextView android:text="PTY_CODE" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6Pty" android:text="00" style="@style/EngValueStyle"/>

                <TextView android:text="RDS_LOCK_UI" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6RdsLock" android:text="NO" style="@style/EngValueStyle"/>
            </GridLayout>

            <!-- OEM Media (misma prefs que K706) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ OEM_MEDIA_SESSION_STATUS ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="8dp">

                <TextView android:text="LAST_FOCUS_EVENT" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6OemFocusEvent" android:text="N/A" style="@style/EngValueStyle"/>

                <TextView android:text="OEM_FLAGS" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6OemFlags" android:text="N/A" style="@style/EngValueStyle"/>
            </GridLayout>

            <!-- Assets -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ FILE_SYSTEM_INTEGRITY ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tvQs6Assets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:text="..."/>

            <!-- System -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#3300FF00"
                android:padding="4dp"
                android:text="[ ANDROID_OS_DIAGNOSTICS ]"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="8dp">

                <TextView android:text="AIDL_CALL_LATENCY" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6Latency" android:text="0ms" style="@style/EngValueStyle"/>

                <TextView android:text="MEMORY_HEAP" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6Memory" android:text="0/0MB" style="@style/EngValueStyle"/>

                <TextView android:text="DEVICE_MODEL" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6Device" android:text="UNKNOWN" style="@style/EngValueStyle"/>

                <TextView android:text="ROOT_LEVEL" style="@style/EngLabelStyle"/>
                <TextView android:id="@+id/tvQs6Root" android:text="..." style="@style/EngValueStyle"/>
            </GridLayout>

        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/scrollQs6Log"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#2200FF00"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnQs6Exit">
        <TextView
            android:id="@+id/tvQs6Log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:textColor="#00FF00"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:text="[NWD] SYNC..."/>
    </ScrollView>

    <Button
        android:id="@+id/btnQs6Exit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[ TERMINATE_QS6_NWD_ENGINEERING ]"
        android:fontFamily="monospace"
        android:textColor="#FF0000"
        android:backgroundTint="#220000"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
