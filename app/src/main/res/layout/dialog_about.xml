<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="500dp"
    android:layout_height="wrap_content"
    android:background="#E6121212"
    android:padding="16dp"
    android:scrollbars="none">

    <LinearLayout style="@style/DialogContainerStyle">

        <!-- Header -->
        <LinearLayout style="@style/DialogTitleLayout"
            android:gravity="center"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_openradio"
                android:textColor="#00E676"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivAboutAppLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_app_logo"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text=""
            tools:text="Versión 5.0.13 (Beta)"
            android:layout_marginBottom="24dp"/>

        <!-- SUBHEADER -->
        <TextView
            style="@style/DialogSubheaderText"
            android:text="@string/about_info_header"
            android:textColor="#FFD600"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#222222"
            android:padding="12dp">

            <!-- Dev Info -->
            <LinearLayout 
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="@string/about_dev_by"
                    android:layout_marginBottom="2dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp"
                    android:text="@string/about_contrib_jimmy80"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp"
                    android:text="@string/about_contrib_csaba"/>
            </LinearLayout>

            <View 
                android:layout_width="match_parent" 
                android:layout_height="1dp" 
                android:background="#444444" 
                android:layout_marginBottom="12dp"/>

            <!-- Tech Info -->
            <LinearLayout 
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="@string/about_tech_details"
                    android:layout_marginBottom="2dp"/>
                <TextView 
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/about_tech_details_value"/>
            </LinearLayout>

            <View 
                android:layout_width="match_parent" 
                android:layout_height="1dp" 
                android:background="#444444" 
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>

            <!-- Credits Info -->
            <TextView
                android:id="@+id/tvIcons8Credit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:text="@string/about_icons_by"
                android:layout_gravity="center_horizontal"/>

            <TextView
                android:id="@+id/tvTdtchannelsCredit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:text="@string/about_streaming_logos_by"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Close -->
        <TextView
            android:id="@+id/btnClose"
            style="@style/DialogCloseButton"
            android:text="@string/close"
            />

    </LinearLayout>
</ScrollView>
