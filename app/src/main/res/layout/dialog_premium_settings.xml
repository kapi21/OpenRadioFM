<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="650dp"
    android:layout_height="wrap_content"
    android:background="#E6121212"
    android:padding="16dp"
    android:scrollbars="none">

    <LinearLayout style="@style/DialogContainerStyle">

        <!-- Header -->
        <LinearLayout style="@style/DialogTitleLayout">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/radio_eq_n" />
            <TextView
                style="@style/DialogTitleText"
                android:text="@string/premium_customization" />
        </LinearLayout>

        <!-- Apariencia -->
        <TextView
            style="@style/DialogSubheaderText"
            android:layout_marginTop="0dp"
            android:text="@string/settings_section_appearance" />

        <LinearLayout
            android:id="@+id/cardTheme"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/select_skin" />
            <TextView
                android:id="@+id/tvThemeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                tools:text="Night Mode" />
            <!-- Mantener IDs para previsualización sin ocupar 3ª línea -->
            <View
                android:id="@+id/viewColorPreview"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardFonts"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/select_font" />
            <TextView
                android:id="@+id/tvFontNameSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                tools:text="Defecto (System)" />
            <!-- Mantener ID para selector/preview sin ocupar 3ª línea -->
            <TextView
                android:id="@+id/tvFontPreview"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:text="Abc 123" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardBackground"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/background_mode" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_app_logo" />
                <TextView
                    android:id="@+id/tvBackgroundStatus"
                    style="@style/DialogBoxDesc"
                    android:layout_weight="1"
                    android:text="@string/touch_to_change" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowIconPack"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/icon_pack" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvCurrentIconPack"
                    style="@style/DialogBoxDesc"
                    android:layout_weight="1"
                    android:text="@string/icon_pack_default" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#AAAAAA"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowPresetNumbers"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/preset_numbers" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvCurrentPresetNumbers"
                    style="@style/DialogBoxDesc"
                    android:layout_weight="1"
                    android:text="@string/preset_numbers_default" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#AAAAAA"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowReliefHd"
            style="@style/SettingsRowStyle">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/relief_hd"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvSummaryReliefHd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    tools:text="Desactivado" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchReliefHd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsRowStyle">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/night_mode_auto"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvSummaryNightMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    tools:text="Desactivado" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchNightMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsRowStyle">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/night_mode_logos"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvSummaryNightLogos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    tools:text="Activado" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchNightLogos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowNightSchedule"
            style="@style/SettingsRowStyle"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/night_schedule"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvNightScheduleSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    tools:text="19:00 — 07:00" />
            </LinearLayout>
            <!-- Mantener ids para TimePicker (texto no visible; horario en tvNightScheduleSummary) -->
            <TextView
                android:id="@+id/tvNightStart"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/tvNightEnd"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#AAAAAA"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowLogoMode"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/logo_mode_label" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvCurrentLogoMode"
                    style="@style/DialogBoxDesc"
                    android:layout_weight="1"
                    android:text="@string/logo_mode_car" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#AAAAAA"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowLayout2Side"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/layout2_side_label" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvCurrentLayout2Side"
                    style="@style/DialogBoxDesc"
                    android:layout_weight="1"
                    android:text="@string/layout2_side_presets_left" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#AAAAAA"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Audio y pantalla -->
        <TextView
            style="@style/DialogSubheaderText"
            android:layout_marginTop="16dp"
            android:text="@string/settings_section_audio_screen" />

        <LinearLayout style="@style/SettingsRowStyle">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_bar_v2"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvSummaryStatusBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    tools:text="Desactivado" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swStatusBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsRowStyle">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_hide_controls"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvSummaryAutoHide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    tools:text="Desactivado" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swAutoHideControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsRowStyle">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/preset_scroll_loop_title"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/preset_scroll_loop_desc"
                    android:textColor="#888888"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvSummaryPresetScrollLoop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    tools:text="Desactivado" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swPresetScrollLoop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSignalMeterBars"
            style="@style/SettingsRowStyle">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/signal_meter_bars_title"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/signal_meter_bars_desc"
                    android:textColor="#888888"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvSummarySignalMeterBars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    tools:text="Desactivado" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swSignalMeterBars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Nube -->
        <TextView
            style="@style/DialogSubheaderText"
            android:layout_marginTop="16dp"
            android:text="@string/settings_section_cloud" />

        <LinearLayout style="@style/SettingsRowStyle">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/online_logos"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvSummaryLogosOnline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    tools:text="Activado" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchLogosOnline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowLogoProvider"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/logo_provider" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvCurrentLogoProvider"
                    style="@style/DialogBoxDesc"
                    android:layout_weight="1"
                    android:text="@string/provider_supabase" />
                <TextView
                    android:id="@+id/tvSupabaseStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="• Desconectado"
                    android:textColor="#FF4444"
                    android:textSize="11sp"
                    android:visibility="gone" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#AAAAAA"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/SettingsRowStyle">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contrib_cloud"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contrib_cloud_desc"
                    android:textColor="#888888"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvSummaryCloudContrib"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    tools:text="Activado" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchCloudContrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Radio avanzado -->
        <TextView
            style="@style/DialogSubheaderText"
            android:layout_marginTop="16dp"
            android:text="@string/settings_section_radio_advanced" />

        <LinearLayout
            android:id="@+id/rowLanguage"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/app_language" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvCurrentLanguage"
                    style="@style/DialogBoxDesc"
                    android:layout_weight="1"
                    android:text="@string/language_spanish" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#AAAAAA"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowCountry"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/app_country" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvCurrentCountry"
                    style="@style/DialogBoxDesc"
                    android:layout_weight="1"
                    android:text="@string/country_es" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#AAAAAA"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/SettingsRowStyle">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/save_history"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/tvSummarySaveHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    tools:text="Activado" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchSaveHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowA11yHijack"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/a11y_hihack_title" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvA11yHijackStatus"
                    style="@style/DialogBoxDesc"
                    android:layout_weight="1"
                    android:text="@string/a11y_hihack_open_settings" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#AAAAAA"
                    android:textSize="20sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/a11y_hihack_boot_reminder_switch"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchHihackBootReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowEngine"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/radio_engine" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvCurrentEngine"
                    style="@style/DialogBoxDesc"
                    android:layout_weight="1"
                    android:text="@string/engine_auto" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#AAAAAA"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowSteeringMode"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/steering_next_prev_mode" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvCurrentSteeringMode"
                    style="@style/DialogBoxDesc"
                    android:layout_weight="1"
                    android:text="@string/steering_mode_seek" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#AAAAAA"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hardware Automation (Dynamic Visibility via Engineering Mode) -->
        <LinearLayout
            android:id="@+id/layoutHwAutomation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/DialogSubheaderText"
                android:layout_marginTop="16dp"
                android:text="@string/hardware_automation_section_header" />

            <!-- HW Auto Night Mode -->
            <LinearLayout
                android:id="@+id/rowHwAutoNight"
                style="@style/SettingsRowStyle">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cambio Automático de Tema (Luces)"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvSummaryHwAutoNight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        tools:text="Activado (Vía MCU)" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swHwAutoNight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- HW Reverse Mute -->
            <LinearLayout
                android:id="@+id/rowHwReverseMute"
                style="@style/SettingsRowStyle">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Silencio en Marcha Atrás"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvSummaryHwReverseMute"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        tools:text="Desactivado" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swHwReverseMute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- HW Handbrake Safety -->
            <LinearLayout
                android:id="@+id/rowHwHandbrake"
                style="@style/SettingsRowStyle">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Seguridad Freno de Mano"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvSummaryHwHandbrake"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#888888"
                        android:textSize="11sp"
                        tools:text="Advertencia visual" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swHwHandbrake"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Información -->
        <TextView
            style="@style/DialogSubheaderText"
            android:layout_marginTop="16dp"
            android:text="@string/settings_section_about" />

        <LinearLayout
            android:id="@+id/btnAbout"
            style="@style/SettingsRowStyle"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/about_openradio"
                android:textColor="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#AAAAAA"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnAcknowledgements"
            style="@style/SettingsRowStyle"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ack_title"
                android:textColor="@color/white" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#AAAAAA"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCloseSettings"
            style="@style/DialogCloseButton"
            android:text="@string/close" />

    </LinearLayout>
</ScrollView>
