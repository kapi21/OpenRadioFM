<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="650dp"
    android:layout_height="wrap_content"
    android:background="#E6121212"
    android:padding="16dp"
    android:scrollbars="none">

    <LinearLayout style="@style/DialogContainerStyle">

        <!-- Header -->
        <LinearLayout style="@style/DialogTitleLayout">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/radio_eq_n"
                android:layout_marginEnd="12dp"/>
            <TextView
                style="@style/DialogTitleText"
                android:text="@string/premium_customization"/>
        </LinearLayout>

        <!-- SECTION: PERSONALIZACIÓN PREMIUM -->
        <TextView
            style="@style/DialogSubheaderText"
            android:text="@string/premium_customization"/>

        <!-- Tema -->
        <LinearLayout
            android:id="@+id/cardTheme"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/select_skin"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:id="@+id/viewColorPreview"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/radio_icon_p01"
                    android:layout_marginEnd="12dp"/>
                <TextView
                    style="@style/DialogBoxDesc"
                    android:text="@string/touch_to_change"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Tipografía -->
        <LinearLayout
            android:id="@+id/cardFonts"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/select_font"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvFontPreview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Abc 123"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:layout_marginEnd="12dp"/>
                <TextView
                    style="@style/DialogBoxDesc"
                    android:text="@string/touch_to_change"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Modo de Fondo -->
        <LinearLayout
            android:id="@+id/cardBackground"
            style="@style/DialogBoxStyle">
            <TextView
                style="@style/DialogBoxTitle"
                android:text="@string/background_mode"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@mipmap/ic_launcher"
                    android:layout_marginEnd="12dp"/>
                <TextView
                    android:id="@+id/tvBackgroundStatus"
                    style="@style/DialogBoxDesc"
                    android:text="@string/touch_to_change"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Modo Noche Automático -->
        <LinearLayout style="@style/SettingsRowStyle">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/night_mode_auto"
                android:textColor="@color/white"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchNightMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Horario Modo Noche -->
        <LinearLayout
            android:id="@+id/rowNightSchedule"
            style="@style/SettingsRowStyle"
            android:visibility="gone">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/night_schedule"
                android:textColor="@color/white"/>
            <TextView
                android:id="@+id/tvNightStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19:00"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:padding="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" — "
                android:textColor="#666666"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/tvNightEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:00"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- Mostrar Barra de Estado -->
        <LinearLayout style="@style/SettingsRowStyle">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/status_bar_v2"
                android:textColor="@color/white"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchStatusBarV2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>


        <!-- SECTION: OPCIONES DE LA APP -->
        <TextView
            style="@style/DialogSubheaderText"
            android:text="@string/app_options"
            android:layout_marginTop="16dp"/>

        <!-- Idioma -->
        <LinearLayout
            android:id="@+id/rowLanguage"
            style="@style/DialogBoxStyle"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_language"
                android:textColor="@color/white"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/tvCurrentLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/language_spanish"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#AAAAAA"
                android:textSize="20sp"/>
        </LinearLayout>

        <!-- Logos Online -->
        <LinearLayout style="@style/SettingsRowStyle">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/online_logos"
                android:textColor="@color/white"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchLogosOnline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Proveedor de Logos -->
        <LinearLayout
            android:id="@+id/rowLogoProvider"
            style="@style/DialogBoxStyle"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/logo_provider"
                android:textColor="@color/white"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/tvCurrentLogoProvider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/provider_supabase"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#AAAAAA"
                android:textSize="20sp"/>
        </LinearLayout>

        <!-- Contribuir a la Comunidad -->
        <LinearLayout style="@style/SettingsRowStyle">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contrib_cloud"
                    android:textColor="@color/white"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/contrib_cloud_desc"
                    android:textColor="#888888"
                    android:textSize="11sp"/>
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchCloudContrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Modo Logo Superior -->
        <LinearLayout
            android:id="@+id/rowLogoMode"
            style="@style/DialogBoxStyle"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/logo_mode_label"
                android:textColor="@color/white"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/tvCurrentLogoMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/logo_mode_car"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#AAAAAA"
                android:textSize="20sp"/>
        </LinearLayout>

        <!-- Guardar Historial -->
        <LinearLayout style="@style/SettingsRowStyle">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/save_history"
                android:textColor="@color/white"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchSaveHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>


        <!-- SECTION: AJUSTES DE HARDWARE -->
        <TextView
            style="@style/DialogSubheaderText"
            android:text="@string/hardware_settings"
            android:layout_marginTop="16dp"/>

        <!-- Forzar Motor de Radio -->
        <LinearLayout
            android:id="@+id/rowEngine"
            style="@style/DialogBoxStyle"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/radio_engine"
                android:textColor="@color/white"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/tvCurrentEngine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/engine_auto"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#AAAAAA"
                android:textSize="20sp"/>
        </LinearLayout>

        <!-- Habilitar AM -->
        <LinearLayout style="@style/SettingsRowStyle">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/enable_am_band"
                android:textColor="@color/white"/>
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEnableAm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>


        <!-- SECTION: ACERCA DE -->
        <LinearLayout
            android:id="@+id/btnAbout"
            style="@style/SettingsRowStyle"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/about_openradio"
                android:textColor="@color/white"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#AAAAAA"
                android:textSize="20sp"/>
        </LinearLayout>

        <!-- Close Button -->
        <TextView
            android:id="@+id/btnCloseSettings"
            style="@style/DialogCloseButton"
            android:text="@string/close"/>

    </LinearLayout>
</ScrollView>
